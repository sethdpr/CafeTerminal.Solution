<?xml version="1.0" encoding="UTF-8" ?>
<Shell 
    x:Class="CafeTerminal.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CafeTerminal.Maui.Views"
    Shell.FlyoutBehavior="Flyout">

    <!-- Logged-out pages -->
    <ShellContent
        x:Name="LoginShellContent"
        Title="Log in"
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}"/>
    <ShellContent
        x:Name="RegisterShellContent"
        Title="Registreer"
        Route="register"
        ContentTemplate="{DataTemplate local:RegisterPage}"/>

    <!-- Logged-in pages -->
    <ShellContent
        x:Name="TablesShellContent"
        Title="Tafels"
        Route="tables"
        ContentTemplate="{DataTemplate local:TablesPage}"/>
    <ShellContent
        x:Name="ProductsShellContent"
        Title="Producten"
        Route="products"
        ContentTemplate="{DataTemplate local:ProductsPage}"/>
</Shell>
