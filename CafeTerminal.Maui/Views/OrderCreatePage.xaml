<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CafeTerminal.Maui.Views.OrderCreatePage"
    Title="Nieuwe bestelling">

    <VerticalStackLayout Padding="12" Spacing="8">
        <Label Text="Selecteer producten" FontSize="18" />

        <CollectionView x:Name="ProductsList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4" HasShadow="False" BorderColor="LightGray">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" VerticalOptions="Center" HorizontalOptions="Start" WidthRequest="120" />
                            <Label Text="{Binding Price, StringFormat='{0:F2} EUR'}" VerticalOptions="Center" WidthRequest="80" />
                            <Stepper Minimum="0" Maximum="20" Increment="1" Value="{Binding Quantity, Mode=TwoWay}" VerticalOptions="Center" />
                            <Label Text="{Binding Quantity}" WidthRequest="40" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Spacing="8">
            <Button Text="Bestelling opslaan" Clicked="OnSaveOrderClicked" />
            <Button Text="Annuleer" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
