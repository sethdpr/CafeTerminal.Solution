<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CafeTerminal.Maui.Views.OrderCreatePage"
    Title="Nieuwe bestelling">

    <Grid
        Padding="12"
        RowSpacing="8"
        RowDefinitions="Auto,*,Auto">

        <Label
            Grid.Row="0"
            Text="Selecteer producten"
            FontSize="18"
            Margin="0,0,0,4" />

        <CollectionView
            Grid.Row="1"
            x:Name="ProductsList"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    VerticalItemSpacing="8"
                    HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame
                        Padding="10"
                        HasShadow="False"
                        BorderColor="LightGray"
                        CornerRadius="8">

                        <VerticalStackLayout
                            Spacing="6">

                            <!-- Product name -->
                            <Label
                                Text="{Binding Name}"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                MaxLines="2" />

                            <!-- Product price -->
                            <Label
                                Text="{Binding Price, StringFormat='{0:F2} EUR'}"
                                FontSize="14"
                                TextColor="Gray"
                                HorizontalTextAlignment="Center" />

                            <!-- Quantity controls -->
                            <Grid
                                HorizontalOptions="Center"
                                ColumnSpacing="8"
                                ColumnDefinitions="45,40,45">

                                <!-- Minus -->
                                <Button
                                    Grid.Column="0"
                                    Text="-"
                                    FontSize="20"
                                    Padding="0"
                                    WidthRequest="45"
                                    HeightRequest="45"
                                    Clicked="OnDecreaseQuantityClicked" />

                                <!-- Quantity -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Quantity}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <!-- Plus -->
                                <Button
                                    Grid.Column="2"
                                    Text="+"
                                    FontSize="20"
                                    Padding="0"
                                    WidthRequest="45"
                                    HeightRequest="45"
                                    Clicked="OnIncreaseQuantityClicked" />

                            </Grid>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Action buttons -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="8"
            ColumnDefinitions="*,*">

            <Button
                Grid.Column="0"
                Text="Bestelling opslaan"
                Clicked="OnSaveOrderClicked" />

            <Button
                Grid.Column="1"
                Text="Annuleer"
                Clicked="OnCancelClicked" />

        </Grid>

    </Grid>

</ContentPage>