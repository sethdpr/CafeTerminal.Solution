<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CafeTerminal.Maui.Views.ProductsPage"
    Title="Products">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Products" FontSize="22" FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="8">
            <Entry x:Name="NameEntry" Placeholder="Name" HorizontalOptions="FillAndExpand" />
            <Entry x:Name="PriceEntry" Placeholder="Price" Keyboard="Numeric" WidthRequest="120" />
            <Button Text="Add" Clicked="OnAddClicked" />
        </HorizontalStackLayout>

        <CollectionView x:Name="ProductsCollection" ItemsSource="{Binding Products}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="6" HasShadow="False" BorderColor="LightGray">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{Binding Name}" FontSize="16" />
                            <Label Text="{Binding Price, StringFormat='{0:F2} EUR'}" FontSize="14" VerticalOptions="Center" />
                            <Button Text="Delete" Clicked="OnDeleteClicked" CommandParameter="{Binding Id}" HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
