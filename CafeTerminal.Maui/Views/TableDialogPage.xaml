<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CafeTerminal.Maui.Views.TableDialogPage"

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label x:Name="TitleLabel" Text="Tafelbeheer" FontSize="20" HorizontalOptions="Center" />

        <Entry x:Name="NameEntry" Placeholder="Naam tafel" />
        <Button x:Name="SaveButton" Text="Opslaan" Clicked="OnSaveClicked" />
        <Button x:Name="AddOrderButton" Text="Voeg bestelling toe" Clicked="OnAddOrderClicked" IsVisible="False" />
        <Button x:Name="PaymentButton" Text="Betaling" Clicked="OnPaymentClicked" IsVisible="False" />

        <Button Text="Sluiten" Clicked="OnCloseClicked" />
    </VerticalStackLayout>

</ContentPage>