<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CafeTerminal.Maui.Views.TablesPage"
    Title="Wolfshagen (bij Rita)">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top controls -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Spacing="12">
            <Button
                Text="Afmelden"
                Clicked="OnLogoutClicked"
                BackgroundColor="Red"
                TextColor="White"
                WidthRequest="100" />
        </HorizontalStackLayout>

        <!-- Tabs -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Tabs}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
            ItemsLayout="HorizontalList"
            HeightRequest="48">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4" HasShadow="False" BorderColor="LightGray">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{Binding Title}" Clicked="OnTabClicked" CommandParameter="{Binding .}" />
                            <Button Text="x" Clicked="OnCloseTabClicked" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Table selection -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding TableItems}"
            HeightRequest="120"
            SelectionMode="None"
            HorizontalOptions="Center">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="0" Margin="8" CornerRadius="8" HasShadow="False" BackgroundColor="Transparent" HorizontalOptions="Center">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnTableTapped" />
                        </Frame.GestureRecognizers>
                        <Label Text="{Binding DisplayText}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" WidthRequest="90" HeightRequest="64" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Content area for selected tab -->
        <ContentView Grid.Row="3" Padding="12">
            <Label Text="{Binding SelectedTab.Title, FallbackValue='Kies een tafel'}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Start" />
        </ContentView>
    </Grid>

</ContentPage>
